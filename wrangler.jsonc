{
  // Config do wrangler para este repositório (diretório = raiz do site estático).
  // Existe porque um wrangler.jsonc de Worker em E:\...\0_2026_Novembro\ é herdado
  // como pai e faria o wrangler tratar o deploy como Worker em vez de Pages.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prototipos",
  "pages_build_output_dir": "."
}
